generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  role      UserRole @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  doctorProfile Doctor?

  @@map("users")
}

model Doctor {
  id              String         @id @default(cuid())
  userId          String?        @unique
  name            String
  email           String         @unique
  phone           String
  speciality      String
  bio             String?
  imageUrl        String
  gender          Gender
  isActive        Boolean        @default(true)
  approvalStatus  DoctorApproval @default(APPROVED)
  licenseNumber   String?
  clinicAddress   String?
  consultationFee Decimal        @default(0) @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  commissions  Commission[]

  @@map("doctors")
}

model Appointment {
  id                    String             @id @default(cuid())
  date                  DateTime
  time                  String
  duration              Int                @default(30)
  status                AppointmentStatus  @default(PENDING)
  notes                 String?
  reason                String?
  consultationFee       Decimal            @default(0) @db.Decimal(10, 2)
  actualAmountCollected Decimal?           @db.Decimal(10, 2)
  paymentMethod         PaymentMethod?
  dentistReportedAmount Decimal?           @db.Decimal(10, 2)
  dentistPaymentMethod  PaymentMethod?
  dentistReportedAt     DateTime?
  patientReportedAmount Decimal?           @db.Decimal(10, 2)
  patientPaymentMethod  PaymentMethod?
  patientReportedAt     DateTime?
  verificationStatus    VerificationStatus @default(NOT_STARTED)
  dentistConfirmedAt    DateTime?
  patientConfirmedAt    DateTime?
  verificationDeadline  DateTime?
  patientReminderSentAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  userId   String
  doctorId String

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor     Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  commission Commission?
  events     VerificationEvent[]

  @@map("appointments")
}

model Commission {
  id               String           @id @default(cuid())
  appointmentId    String           @unique
  doctorId         String
  collectedAmount  Decimal          @db.Decimal(10, 2)
  commissionRate   Decimal          @db.Decimal(5, 4)
  commissionAmount Decimal          @db.Decimal(10, 2)
  status           CommissionStatus @default(DUE)
  settledAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("commissions")
}

model CommissionSetting {
  id        String   @id @default("default")
  rate      Decimal  @db.Decimal(5, 4)
  updatedAt DateTime @updatedAt

  @@map("commission_settings")
}

model VerificationEvent {
  id            String   @id @default(cuid())
  appointmentId String
  actorUserId   String?
  eventType     String
  details       Json?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("verification_events")
}

enum UserRole {
  PATIENT
  DENTIST
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum DoctorApproval {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  REJECTED
  CANCELLED
}

enum VerificationStatus {
  NOT_STARTED
  AWAITING_PATIENT
  VERIFIED
  DISPUTED
  EXPIRED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum CommissionStatus {
  DUE
  SETTLED
  DISPUTED
}
